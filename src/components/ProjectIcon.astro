---
import { Icon } from "astro-icon/components";

export type ProjectIconName =
  | "arrow-right"
  | "arrow-up-right"
  | "briefcase"
  | "check-square"
  | "circles-three-plus"
  | "clipboard-text"
  | "envelope-simple"
  | "file-text"
  | "globe-hemisphere-west"
  | "linkedin-logo"
  | "list"
  | "list-checks"
  | "magnifying-glass"
  | "package"
  | "paper-plane-tilt"
  | "seal-check"
  | "strategy"
  | "users-three"
  | "wechat-logo"
  | "whatsapp-logo"
  | "factory"
  | "network"
  | "database"
  | "chart-line-up"
  | "x"
  | "dots-three"
  | "globe"
  | "sliders-horizontal"
  | "truck"
  | "caret-down"
  | "arrow-down"
  | "check"
  | "map-trifold"
  | "map-pin"
  | "sparkle";

interface Props {
  name: ProjectIconName;
  label?: string;
  size?: number | string;
  class?: string;
}

const { name, label, size = 18, class: className } = Astro.props;

const iconNames: Record<ProjectIconName, string> = {
  "arrow-right": "ph:arrow-right",
  "arrow-up-right": "ph:arrow-up-right",
  "briefcase": "ph:briefcase",
  "check-square": "ph:check-square",
  "circles-three-plus": "ph:circles-three-plus",
  "clipboard-text": "ph:clipboard-text",
  "envelope-simple": "ph:envelope-simple",
  "file-text": "ph:file-text",
  "globe-hemisphere-west": "ph:globe-hemisphere-west",
  "linkedin-logo": "ph:linkedin-logo",
  "list": "ph:list",
  "list-checks": "ph:list-checks",
  "magnifying-glass": "ph:magnifying-glass",
  "package": "ph:package",
  "paper-plane-tilt": "ph:paper-plane-tilt",
  "seal-check": "ph:seal-check",
  "strategy": "ph:strategy",
  "users-three": "ph:users-three",
  "wechat-logo": "ph:wechat-logo",
  "whatsapp-logo": "ph:whatsapp-logo",
  "factory": "ph:factory",
  "network": "ph:network",
  "database": "ph:database",
  "chart-line-up": "ph:chart-line-up",
  "x": "ph:x",
  "dots-three": "ph:dots-three",
  "globe": "ph:globe",
  "sliders-horizontal": "ph:sliders-horizontal",
  "truck": "ph:truck",
  "caret-down": "ph:caret-down",
  "arrow-down": "ph:arrow-down",
  "check": "ph:check",
  "map-trifold": "ph:map-trifold",
  "map-pin": "ph:map-pin-fill",
  "sparkle": "ph:sparkle"
};
---

<Icon
  name={iconNames[name]}
  width={size}
  height={size}
  class:list={["project-icon", className]}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  focusable="false"
/>
