<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.documentElement.classList.add("is-ready");

  const reveal = (element: Element) => element.classList.add("is-visible");
  const reveals = [...document.querySelectorAll("[data-reveal]")];
  if (reduceMotion || !("IntersectionObserver" in window)) reveals.forEach(reveal);
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      reveal(entry.target);
      observer.unobserve(entry.target);
    }), { threshold: .12, rootMargin: "0px 0px -5%" });
    reveals.forEach((element) => observer.observe(element));
  }

  const runCounter = (counter: HTMLElement) => {
    const target = Number(counter.dataset.count ?? 0);
    const suffix = counter.dataset.suffix ?? "";
    if (counter.dataset.counted === "true") return;
    counter.dataset.counted = "true";
    if (reduceMotion) { counter.textContent = `${target}${suffix}`; return; }
    const started = performance.now();
    counter.textContent = `0${suffix}`;
    const step = (now: number) => {
      const progress = Math.min((now - started) / 1500, 1);
      counter.textContent = `${Math.round(target * (1 - Math.pow(1 - progress, 3)))}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  document.querySelectorAll<HTMLElement>("[data-metric-strip]").forEach((strip) => {
    const showMetrics = () => {
      strip.classList.add("is-animated");
      strip.querySelectorAll<HTMLElement>("[data-count]").forEach(runCounter);
    };
    if (reduceMotion || !("IntersectionObserver" in window)) showMetrics();
    else {
      const metricObserver = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        window.setTimeout(showMetrics, 180);
        metricObserver.disconnect();
      }, { threshold: .52, rootMargin: "0px 0px -10%" });
      metricObserver.observe(strip);
    }
  });

  document.querySelectorAll<HTMLElement>("[data-console]").forEach((consoleEl) => {
    const rows = [...consoleEl.querySelectorAll<HTMLElement>("[data-console-row]")];
    let active = Math.max(0, rows.findIndex((row) => row.classList.contains("is-active")));
    let timer = 0;
    const setActive = (index: number) => {
      active = index;
      rows.forEach((row, i) => row.classList.toggle("is-active", i === index));
    };
    rows.forEach((row, index) => row.addEventListener("click", () => setActive(index)));
    const start = () => {
      if (reduceMotion || consoleEl.dataset.consoleAuto !== "true" || timer) return;
      timer = window.setInterval(() => setActive((active + 1) % rows.length), 1800);
    };
    const stop = () => { window.clearInterval(timer); timer = 0; };
    consoleEl.addEventListener("pointerenter", stop);
    consoleEl.addEventListener("pointerleave", start);
    consoleEl.addEventListener("focusin", stop);
    consoleEl.addEventListener("focusout", start);
    start();
  });

  document.querySelectorAll<HTMLElement>("[data-process]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-process-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-process-panel]")];
    let active = Math.max(0, tabs.findIndex((tab) => tab.classList.contains("is-active")));
    let timer = 0;
    let visible = false;
    const stop = () => { window.clearTimeout(timer); timer = 0; };
    const activate = (index: number) => {
      active = index;
      tabs.forEach((item, i) => { item.classList.toggle("is-active", i === index); item.setAttribute("aria-selected", String(i === index)); });
      panels.forEach((panel, i) => { panel.hidden = i !== index; panel.classList.toggle("is-active", i === index); });
      root.style.setProperty("--process-progress", `${tabs.length > 1 ? index / (tabs.length - 1) * 100 : 0}%`);
    };
    const schedule = (delay = 3200) => {
      stop();
      if (reduceMotion || !visible || tabs.length < 2 || document.hidden) return;
      timer = window.setTimeout(() => {
        const next = (active + 1) % tabs.length;
        if (next === 0) root.classList.add("is-resetting");
        activate(next);
        if (next === 0) requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("is-resetting")));
        schedule(next === tabs.length - 1 ? 4000 : 3200);
      }, delay);
    };
    const userActivate = (index: number) => { activate(index); schedule(6500); };
    activate(active);
    tabs.forEach((tab, index) => tab.addEventListener("click", () => userActivate(index)));
    tabs.forEach((tab, index) => tab.addEventListener("keydown", (event) => {
      if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 :
        (index + (event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
      tabs[next]?.focus(); userActivate(next);
    }));
    if (reduceMotion || !("IntersectionObserver" in window)) { visible = true; schedule(1800); }
    else {
      const processObserver = new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) schedule(1800); else stop();
      }, { threshold: .35 });
      processObserver.observe(root);
    }
    document.addEventListener("visibilitychange", () => { if (document.hidden) stop(); else schedule(1800); });
  });

  document.querySelectorAll<HTMLElement>("[data-market-map]").forEach((map) => {
    const pins = [...map.querySelectorAll<HTMLElement>("[data-market-pin]")];
    const showPins = () => pins.forEach((pin) => pin.classList.add("is-lit"));
    if (reduceMotion || !("IntersectionObserver" in window)) showPins();
    else {
      const mapObserver = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        showPins();
        mapObserver.disconnect();
      }, { threshold: .62, rootMargin: "0px 0px -10%" });
      mapObserver.observe(map);
    }
  });

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-gallery-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-gallery-panel]")];
    let active = Math.max(0, tabs.findIndex((tab) => tab.classList.contains("is-active")));
    let timer = 0;
    let visible = false;
    let pointerInside = false;
    let keyboardFocus = false;
    let resumeAt = 0;
    const stop = () => { window.clearTimeout(timer); timer = 0; };
    const activate = (index: number) => {
      active = index;
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === index);
        tab.setAttribute("aria-selected", String(i === index));
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        panel.classList.toggle("is-active", i === index);
      });
    };
    const schedule = (delay = 4200) => {
      stop();
      if (reduceMotion || !visible || pointerInside || keyboardFocus || tabs.length < 2 || document.hidden) return;
      const remainingHold = Math.max(0, resumeAt - Date.now());
      timer = window.setTimeout(() => { activate((active + 1) % tabs.length); schedule(); }, Math.max(delay, remainingHold));
    };
    const userActivate = (index: number) => {
      activate(index);
      resumeAt = Date.now() + 8000;
      schedule(8000);
    };
    activate(active);
    tabs.forEach((tab, index) => {
      tab.addEventListener("pointerdown", () => { keyboardFocus = false; });
      tab.addEventListener("click", () => userActivate(index));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        keyboardFocus = true;
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 :
          (index + (event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next]?.focus();
        userActivate(next);
      });
    });
    root.addEventListener("pointerenter", () => { pointerInside = true; stop(); });
    root.addEventListener("pointerleave", () => { pointerInside = false; schedule(1800); });
    root.addEventListener("focusout", () => requestAnimationFrame(() => {
      if (root.matches(":focus-within")) return;
      keyboardFocus = false;
      schedule(1800);
    }));
    document.addEventListener("image-lightbox:open", stop);
    document.addEventListener("image-lightbox:close", () => schedule(1800));
    if (reduceMotion || !("IntersectionObserver" in window)) { visible = true; schedule(1800); }
    else {
      const galleryObserver = new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) schedule(1800); else stop();
      }, { threshold: .32 });
      galleryObserver.observe(root);
    }
    document.addEventListener("visibilitychange", () => { if (document.hidden) stop(); else schedule(1800); });
  });

  document.querySelectorAll<HTMLElement>("[data-ecosystem]").forEach((ecosystem) => {
    const bloom = () => ecosystem.classList.add("is-bloomed");
    if (reduceMotion || !("IntersectionObserver" in window)) bloom();
    else {
      const ecosystemObserver = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        bloom();
        ecosystemObserver.disconnect();
      }, { threshold: .62, rootMargin: "0px 0px -8%" });
      ecosystemObserver.observe(ecosystem);
    }
  });

  const imageDialog = document.querySelector<HTMLDialogElement>("[data-image-lightbox]");
  const lightboxImage = imageDialog?.querySelector<HTMLImageElement>("[data-image-lightbox-image]");
  const lightboxTitle = imageDialog?.querySelector<HTMLElement>("[data-image-lightbox-title]");
  const lightboxClose = imageDialog?.querySelector<HTMLButtonElement>("[data-image-lightbox-close]");
  let lastImageTrigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLElement>("[data-image-zoom]").forEach((trigger) => trigger.addEventListener("click", () => {
    if (!imageDialog || !lightboxImage || !lightboxTitle) return;
    lastImageTrigger = trigger;
    lightboxImage.src = trigger.dataset.imageSrc ?? "";
    lightboxImage.alt = trigger.dataset.imageAlt ?? "";
    lightboxTitle.textContent = trigger.dataset.imageTitle ?? "";
    document.documentElement.classList.add("has-lightbox");
    document.dispatchEvent(new CustomEvent("image-lightbox:open"));
    imageDialog.showModal();
  }));
  lightboxClose?.addEventListener("click", () => imageDialog?.close());
  imageDialog?.addEventListener("click", (event) => {
    if (event.target === imageDialog || (event.target instanceof HTMLElement && event.target.matches(".image-lightbox-canvas"))) imageDialog.close();
  });
  imageDialog?.addEventListener("close", () => {
    document.documentElement.classList.remove("has-lightbox");
    if (lightboxImage) lightboxImage.src = "";
    lastImageTrigger?.focus();
    document.dispatchEvent(new CustomEvent("image-lightbox:close"));
  });

  const header = document.querySelector<HTMLElement>("[data-header]");
  const updateHeader = () => header?.classList.toggle("is-scrolled", scrollY > 16);
  updateHeader(); addEventListener("scroll", updateHeader, { passive: true });

  const pageScrollBehavior: ScrollBehavior = reduceMotion ? "auto" : "smooth";
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]:not(.skip-link)');
    if (!link) return;
    const hash = link.getAttribute("href");
    if (!hash || hash === "#") return;
    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!target) return;
    event.preventDefault();
    target.scrollIntoView({ behavior: pageScrollBehavior, block: "start" });
    if (location.hash !== hash) history.pushState(null, "", hash);
  });

  const shippingProgress = document.querySelector<HTMLElement>("[data-shipping-progress]");
  const shippingTrack = shippingProgress?.querySelector<HTMLElement>("[data-shipping-track]");
  const shippingVessel = shippingProgress?.querySelector<HTMLElement>("[data-shipping-vessel]");
  let shippingFrame = 0;
  let sailingTimer = 0;
  let shippingDragPointer = -1;
  let shippingDragStartX = 0;
  let shippingDragWidth = 1;
  let shippingDragTarget = 0;
  let shippingDragFrame = 0;
  let shippingDragFrameTime = 0;
  let shippingDragDirection = 0;
  let shippingDragOriginTop = 0;
  let shippingDragOriginIndex = 0;
  let shippingDragSnapTarget: HTMLElement | null = null;
  const shippingJourney = () => Math.max(1, document.documentElement.scrollHeight - innerHeight);
  const shippingValue = () => Math.min(100, Math.max(0, scrollY / shippingJourney() * 100));
  const shippingSections = () => Array.from(document.querySelectorAll<HTMLElement>("#main-content > section"));
  const shippingSectionTop = (section: HTMLElement) => {
    const scrollPadding = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    return Math.min(shippingJourney(), Math.max(0, section.offsetTop - scrollPadding));
  };
  const animateShippingDrag = (time: number) => {
    const scroller = document.scrollingElement ?? document.documentElement;
    const elapsed = shippingDragFrameTime ? Math.min(40, time - shippingDragFrameTime) : 16.7;
    const follow = 1 - Math.exp(-elapsed / 48);
    const distance = shippingDragTarget - scroller.scrollTop;
    shippingDragFrameTime = time;
    if (Math.abs(distance) <= .5) {
      scroller.scrollTop = shippingDragTarget;
      shippingDragFrame = 0;
      shippingDragFrameTime = 0;
      return;
    }
    scroller.scrollTop += distance * follow;
    shippingDragFrame = requestAnimationFrame(animateShippingDrag);
  };
  const requestShippingDragAnimation = () => {
    if (shippingDragFrame) return;
    shippingDragFrameTime = 0;
    shippingDragFrame = requestAnimationFrame(animateShippingDrag);
  };
  const setShippingValue = (value: number, fromDrag = false) => {
    if (!shippingVessel) return;
    const clampedValue = Math.min(100, Math.max(0, value));
    const target = shippingJourney() * clampedValue / 100;
    shippingVessel.style.left = `${clampedValue.toFixed(3)}%`;
    shippingVessel.setAttribute("aria-valuenow", String(Math.round(clampedValue)));
    if (fromDrag) {
      shippingDragTarget = target;
      requestShippingDragAnimation();
      return;
    }
    scrollTo({ top: target, behavior: pageScrollBehavior });
  };
  const updateShippingProgress = () => {
    shippingFrame = 0;
    if (!shippingProgress || !shippingVessel) return;
    if (shippingDragPointer !== -1 || shippingDragFrame) return;
    const value = shippingValue();
    const position = `${value.toFixed(3)}%`;
    shippingVessel.style.left = position;
    shippingVessel.setAttribute("aria-valuenow", String(Math.round(value)));
  };
  const requestShippingUpdate = () => {
    if (shippingFrame) return;
    shippingFrame = requestAnimationFrame(updateShippingProgress);
  };
  const markShippingAsMoving = () => {
    if (!shippingProgress || reduceMotion) return;
    shippingProgress.classList.add("is-sailing");
    window.clearTimeout(sailingTimer);
    sailingTimer = window.setTimeout(() => shippingProgress.classList.remove("is-sailing"), 560);
  };
  updateShippingProgress();
  addEventListener("scroll", () => { markShippingAsMoving(); requestShippingUpdate(); }, { passive: true });
  addEventListener("resize", requestShippingUpdate, { passive: true });

  shippingVessel?.addEventListener("pointerdown", (event) => {
    if (!shippingTrack || (event.pointerType === "mouse" && event.button !== 0)) return;
    shippingDragPointer = event.pointerId;
    shippingDragStartX = event.clientX;
    shippingDragWidth = Math.max(1, shippingTrack.getBoundingClientRect().width);
    shippingDragTarget = scrollY;
    shippingDragDirection = 0;
    shippingDragOriginTop = scrollY;
    shippingDragSnapTarget = null;
    const sections = shippingSections();
    shippingDragOriginIndex = sections.reduce((nearestIndex, section, index) => {
      const nearestDistance = Math.abs(shippingSectionTop(sections[nearestIndex]) - scrollY);
      const candidateDistance = Math.abs(shippingSectionTop(section) - scrollY);
      return candidateDistance < nearestDistance ? index : nearestIndex;
    }, 0);
    if (shippingFrame) cancelAnimationFrame(shippingFrame);
    shippingFrame = 0;
    shippingVessel.setPointerCapture(event.pointerId);
    shippingProgress?.classList.add("is-dragging", "is-sailing");
    document.documentElement.classList.add("is-dragging-shipping", "is-shipping-scroll-controlled");
    window.clearTimeout(sailingTimer);
    event.preventDefault();
  });
  shippingVessel?.addEventListener("pointermove", (event) => {
    if (event.pointerId !== shippingDragPointer) return;
    const totalDelta = event.clientX - shippingDragStartX;
    if (Math.abs(totalDelta) >= 2) shippingDragDirection = Math.sign(totalDelta);
    const sections = shippingSections();
    const destinationIndex = Math.min(sections.length - 1, Math.max(0, shippingDragOriginIndex + shippingDragDirection));
    shippingDragSnapTarget = sections[destinationIndex] ?? null;
    const destinationTop = shippingDragSnapTarget ? shippingSectionTop(shippingDragSnapTarget) : shippingDragOriginTop;
    const gestureDistance = Math.min(260, Math.max(120, shippingDragWidth * .26));
    const gestureProgress = Math.min(1, Math.abs(totalDelta) / gestureDistance);
    const easedProgress = 1 - Math.pow(1 - gestureProgress, 3);
    shippingDragTarget = shippingDragOriginTop + (destinationTop - shippingDragOriginTop) * easedProgress;
    const targetValue = shippingDragTarget / shippingJourney() * 100;
    if (shippingVessel) {
      shippingVessel.style.left = `${targetValue.toFixed(3)}%`;
      shippingVessel.setAttribute("aria-valuenow", String(Math.round(targetValue)));
    }
    requestShippingDragAnimation();
    event.preventDefault();
  });
  const finishShippingDrag = (event: PointerEvent) => {
    if (event.pointerId !== shippingDragPointer) return;
    const destination = event.type === "pointercancel" || shippingDragDirection === 0 ? null : shippingDragSnapTarget;
    shippingDragPointer = -1;
    if (shippingDragFrame) cancelAnimationFrame(shippingDragFrame);
    shippingDragFrame = 0;
    shippingDragFrameTime = 0;
    shippingProgress?.classList.remove("is-dragging");
    document.documentElement.classList.remove("is-dragging-shipping", "is-shipping-scroll-controlled");
    if (shippingVessel?.hasPointerCapture(event.pointerId)) shippingVessel.releasePointerCapture(event.pointerId);
    updateShippingProgress();
    requestAnimationFrame(() => destination?.scrollIntoView({ behavior: pageScrollBehavior, block: "start" }));
    window.clearTimeout(sailingTimer);
    sailingTimer = window.setTimeout(() => shippingProgress?.classList.remove("is-sailing"), 560);
  };
  shippingVessel?.addEventListener("pointerup", finishShippingDrag);
  shippingVessel?.addEventListener("pointercancel", finishShippingDrag);
  shippingVessel?.addEventListener("lostpointercapture", finishShippingDrag);
  shippingVessel?.addEventListener("keydown", (event) => {
    const current = shippingValue();
    const next = event.key === "Home" ? 0
      : event.key === "End" ? 100
      : event.key === "PageDown" ? current + 10
      : event.key === "PageUp" ? current - 10
      : event.key === "ArrowRight" || event.key === "ArrowDown" ? current + 2
      : event.key === "ArrowLeft" || event.key === "ArrowUp" ? current - 2
      : null;
    if (next === null) return;
    event.preventDefault();
    setShippingValue(next);
    markShippingAsMoving();
  });
</script>
