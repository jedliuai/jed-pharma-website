---
import { metrics, type Locale } from "@/config/site";
import { common } from "@/data/copy";
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="metric-strip" aria-label={locale === "zh" ? "个人脱敏业务数据" : "Anonymized personal working ranges"}>
  <div class="shell metric-grid">
    {metrics.slice(0, 3).map((metric) => {
      const amount = Number.parseInt(metric.value);
      return <div class="metric" data-reveal><strong data-count={amount} data-suffix="+">{amount}+</strong><span>{metric.label[locale]}</span></div>;
    })}
  </div>
  <p class="shell metric-note">{common[locale].metricsNote}</p>
</section>
