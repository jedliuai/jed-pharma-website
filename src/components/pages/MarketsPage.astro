---
import BaseLayout from "@/layouts/BaseLayout.astro"; import PageHero from "@/components/PageHero.astro"; import ContactBand from "@/components/ContactBand.astro"; import SectionHeading from "@/components/SectionHeading.astro"; import ProjectIcon from "@/components/ProjectIcon.astro"; import { routeMap, type Locale } from "@/config/site"; import { markets } from "@/data/copy";
interface Props { locale: Locale } const { locale }=Astro.props; const page=markets[locale];
---
<BaseLayout locale={locale} route="markets" path={routeMap.markets[locale]}><PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="02"/>
<section class="section"><div class="shell market-feature"><figure class="map-window" data-reveal><div class="window-bar"><span>MARKET EXPERIENCE</span><ProjectIcon name="map-trifold"/></div><img src="/images/markets-map-v2.png" width="1600" height="800" alt={locale === "zh" ? "市场经验地图" : "Market experience map"}/><figcaption>{page.note}</figcaption></figure><div class="region-stack">{page.regions.map(([title,code,body],index)=><article data-reveal><header><span>0{index+1}</span><small>{code}</small></header><h2>{title}</h2><p>{body}</p><div class="region-pulse"><i></i><span>{locale === "zh" ? "区域语境" : "REGIONAL CONTEXT"}</span></div></article>)}</div></div></section>
<section class="section process-section"><div class="shell question-layout"><SectionHeading kicker={locale === "zh" ? "判断框架" : "DECISION FRAME"} title={locale === "zh" ? "地图之外，先回答三个问题。" : "Beyond the map, answer three questions."}/><ol>{page.questions.map((q,index)=><li data-reveal><span>0{index+1}</span><h3>{q}</h3><ProjectIcon name="arrow-up-right"/></li>)}</ol></div></section><ContactBand locale={locale}/></BaseLayout>
