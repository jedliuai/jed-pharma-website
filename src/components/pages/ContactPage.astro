---
import BaseLayout from "@/layouts/BaseLayout.astro"; import PageHero from "@/components/PageHero.astro"; import ProjectIcon from "@/components/ProjectIcon.astro"; import {contacts,routeMap,type Locale} from "@/config/site"; import {contact} from "@/data/copy";
interface Props{locale:Locale} const{locale}=Astro.props;const page=contact[locale]; const icons={linkedin:"linkedin-logo",email:"envelope-simple",wechat:"wechat-logo"} as const;
---
<BaseLayout locale={locale} route="contact" path={routeMap.contact[locale]}><PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="05"/><section class="section"><div class="shell contact-layout"><div class="contact-prompt" data-reveal><p class="kicker">{locale === "zh" ? "首次联系" : "FIRST OUTREACH"}</p><h2>{page.promptTitle}</h2><ol>{page.prompts.map((prompt,index)=><li><span>0{index+1}</span><strong>{prompt}</strong></li>)}</ol><p class="contact-note">{page.note}</p></div><div class="channel-list"><h2>{page.responseTitle}</h2>{contacts.map((channel,index)=>channel.dialog?<button type="button" data-open-wechat data-reveal><span>0{index+1}</span><ProjectIcon name={icons[channel.id]} size={24}/><div><strong>{channel.label[locale]}</strong><small>{channel.value[locale]}</small></div><ProjectIcon name="arrow-up-right"/></button>:<a href={channel.href} target={channel.external?"_blank":undefined} rel={channel.external?"noopener noreferrer":undefined} data-reveal><span>0{index+1}</span><ProjectIcon name={icons[channel.id]} size={24}/><div><strong>{channel.label[locale]}</strong><small>{channel.value[locale]}</small></div><ProjectIcon name="arrow-up-right"/></a>)}</div></div></section></BaseLayout>
