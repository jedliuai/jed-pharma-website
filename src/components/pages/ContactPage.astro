---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ProjectIcon, { type ProjectIconName } from "@/components/ProjectIcon.astro";
import { contacts, routeMap, type Locale } from "@/config/site";
import { contact } from "@/data/copy";

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = contact[locale];
const path = routeMap.contact[locale];
const icons: Record<(typeof contacts)[number]["id"], ProjectIconName> = {
  linkedin: "linkedin-logo",
  email: "envelope-simple",
  wechat: "wechat-logo"
};
---

<BaseLayout locale={locale} route="contact" path={path}>
  <div class="detail-v2 detail-v2--contact">
    <PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="05" />
    <section class="detail-v2-section detail-v2-contact" aria-labelledby="contact-options-title">
      <div class="shell detail-v2-contact-layout">
        <div class="detail-v2-contact-intro" data-reveal>
          <p class="eyebrow">{locale === "zh" ? "首次联系" : "FIRST OUTREACH"}</p>
          <h2>{page.promptTitle}</h2>
          <ol>{page.prompts.map((prompt, index) => <li><span>0{index + 1}</span><strong>{prompt}</strong></li>)}</ol>
        </div>
        <div class="detail-v2-contact-channels">
          <header data-reveal><p class="eyebrow">{locale === "zh" ? "联系方式" : "DIRECT CHANNELS"}</p><h2 id="contact-options-title">{page.responseTitle}</h2></header>
          <div class="direct-contacts">
            {contacts.map((channel, index) => channel.dialog ? (
              <button type="button" data-open-wechat data-reveal aria-haspopup="dialog" aria-controls="wechat-dialog">
                <span>{String(index + 1).padStart(2, "0")}</span><strong>{channel.label[locale]}</strong><small>{channel.value[locale]}</small><ProjectIcon name={icons[channel.id]} size={19} />
              </button>
            ) : (
              <a href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noopener noreferrer" : undefined} data-reveal>
                <span>{String(index + 1).padStart(2, "0")}</span><strong>{channel.label[locale]}</strong><small>{channel.value[locale]}</small><ProjectIcon name={icons[channel.id]} size={19} />
              </a>
            ))}
          </div>
        </div>
      </div>
      <aside class="shell detail-v2-boundary" data-reveal><span>NOTE / 01</span><p>{page.note}</p></aside>
    </section>
  </div>
</BaseLayout>
