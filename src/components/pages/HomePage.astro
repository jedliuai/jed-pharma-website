---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import MetricStrip from "@/components/MetricStrip.astro";
import ProjectConsole from "@/components/ProjectConsole.astro";
import ProjectIcon, { type ProjectIconName } from "@/components/ProjectIcon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { contacts, routeMap, site, type Locale } from "@/config/site";
import { common, home } from "@/data/copy";
interface Props { locale: Locale }
const { locale } = Astro.props;
const page = home[locale];
const c = common[locale];
const path = routeMap.home[locale];
const processIcons: ProjectIconName[] = ["magnifying-glass", "briefcase", "file-text", "sliders-horizontal", "truck", "seal-check"];
const workIcons: ProjectIconName[] = ["briefcase", "file-text", "truck", "map-trifold"];
const contactIcons: Record<string, ProjectIconName> = { linkedin: "linkedin-logo", email: "envelope-simple", whatsapp: "whatsapp-logo", wechat: "wechat-logo", card: "circles-three-plus" };
const cockpitImages = locale === "zh"
  ? [
      { src: "/images/cockpit-balance-demo.webp", width: 2048, height: 998 },
      { src: "/images/cockpit-value-demo.webp", width: 1796, height: 876 },
      { src: "/images/cockpit-pareto-demo.webp", width: 1798, height: 875 },
    ]
  : [
      { src: "/images/cockpit-balance-demo-en.webp", width: 1796, height: 876 },
      { src: "/images/cockpit-value-demo-en.webp", width: 1797, height: 875 },
      { src: "/images/cockpit-pareto-demo-en.webp", width: 1795, height: 876 },
    ];
const marketPins = [
  { en: "Mexico", zh: "墨西哥", x: 18.2, y: 43.8, region: "latam" },
  { en: "Honduras", zh: "洪都拉斯", x: 21.8, y: 48.6, region: "latam" },
  { en: "Venezuela", zh: "委内瑞拉", x: 28.6, y: 51.8, region: "latam" },
  { en: "Colombia", zh: "哥伦比亚", x: 25.1, y: 54.4, region: "latam" },
  { en: "Peru", zh: "秘鲁", x: 24.6, y: 61.8, region: "latam" },
  { en: "Paraguay", zh: "巴拉圭", x: 30.4, y: 70.8, region: "latam" },
  { en: "Chile", zh: "智利", x: 27.3, y: 76.6, region: "latam" },
  { en: "Uzbekistan", zh: "乌兹别克斯坦", x: 63.8, y: 43.2, region: "cis" },
];
const interfaceCopy = locale === "zh" ? {
  marketWindow: "市场范围 / 10+ 个国际市场",
  liveTool: "01 / 在线工具",
  privateSystem: "02 / 个人运营系统",
  cockpitWindow: "个人医药订单驾驶舱 / 演示数据",
  informationWorkflow: "03 / 信息工作流",
  ecosystemRole: "医药国际业务"
} : {
  marketWindow: "MARKET CONTEXT / 10+ MARKETS",
  liveTool: "01 / LIVE TOOL",
  privateSystem: "02 / PRIVATE OPERATING SYSTEM",
  cockpitWindow: "PERSONAL PHARMACEUTICAL ORDER COCKPIT / DEMO DATA",
  informationWorkflow: "03 / INFORMATION WORKFLOW",
  ecosystemRole: "INTERNATIONAL BUSINESS"
};
---
<BaseLayout locale={locale} path={path}>
  <section id="top" class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-enter">{c.eyebrow}</p>
        <h1 class="hero-brand hero-enter"><img src={site.logo} width="400" height="201" alt="Jed Liu" /></h1>
        <p class="hero-lead hero-enter">{page.heroLead}</p>
        <p class="hero-caption hero-enter">{page.heroBody}</p>
        <div class="hero-actions hero-enter">
          <ButtonLink href="#contact">{page.primaryCta}</ButtonLink>
          <ButtonLink href="#experience" variant="outline">{page.secondaryCta}</ButtonLink>
        </div>
      </div>
      <div class="hero-console"><ProjectConsole locale={locale} /></div>
    </div>
    <a class="scroll-cue" href="#about" aria-label={locale === "zh" ? "向下浏览" : "Scroll to about"}><span>{locale === "zh" ? "向下" : "SCROLL"}</span><ProjectIcon name="arrow-down" /></a>
  </section>

  <section id="about" class="section about-section">
    <div class="shell about-grid">
      <SectionHeading kicker={page.aboutKicker} title={page.aboutTitle} />
      <div class="about-copy" data-reveal><p>{page.aboutBody}</p></div>
    </div>
    <MetricStrip locale={locale} />
  </section>

  <section id="experience" class="section process-section" data-process>
    <div class="shell process-layout">
      <div class="process-intro">
        <SectionHeading kicker={page.processKicker} title={page.processTitle} />
        <p>{locale === "zh" ? "选择任一阶段，看清一个医药国际项目如何从机会走向交付。" : "Choose a stage to see how an international pharmaceutical opportunity becomes a delivered project."}</p>
      </div>
      <div class="process-console" data-reveal>
        <div class="process-tabs" role="tablist" aria-label={page.processTitle}>
          {page.process.map(([title], index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} class:list={{ "is-active": index === 0 }} data-process-tab><span>0{index + 1}</span>{title}</button>)}
        </div>
        <div class="process-panels">
          {page.process.map(([title, body], index) => <article role="tabpanel" data-process-panel hidden={index !== 0} class:list={{ "is-active": index === 0 }}>
            <span>{locale === "zh" ? "阶段" : "PHASE"} 0{index + 1} / 06</span>
            <ProjectIcon name={processIcons[index]} size={36} />
            <h3>{title}</h3><p>{body}</p>
            <div class="process-line"><i></i><b>{locale === "zh" ? "持续推进" : "KEEP MOVING"}</b></div>
          </article>)}
        </div>
      </div>
    </div>
  </section>

  <section id="markets" class="section markets-section">
    <div class="shell">
      <SectionHeading kicker={page.marketsKicker} title={page.marketsTitle} body={page.marketsBody} />
      <div class="market-workspace">
        <div class="market-map" data-reveal>
          <div class="window-bar"><span>{interfaceCopy.marketWindow}</span><ProjectIcon name="map-trifold" /></div>
          <figure class="market-visual" data-market-map>
            <img src="/images/markets-map-v2.webp" width="1600" height="800" alt={locale === "zh" ? "拉丁美洲、中亚与独联体市场地图" : "Map of Latin America, Central Asia and CIS markets"} loading="lazy" decoding="async" />
            <div class="market-pin-layer" aria-label={locale === "zh" ? "重点市场" : "Focus markets"}>
              {marketPins.map((pin, index) => <span class={`market-pin market-pin--${pin.region}`} data-market-pin style={`--x:${pin.x}%;--y:${pin.y}%;--delay:${index * 280}ms`} tabindex="0" role="img" aria-label={pin[locale]}>
                <ProjectIcon name="map-pin" size={18} /><b>{pin[locale]}</b>
              </span>)}
            </div>
            <figcaption>
              {page.regions.map(([title, places, body], index) => <article>
                <span>0{index + 1}</span><div><h3>{title}</h3><strong>{places}</strong><p>{body}</p></div>
              </article>)}
            </figcaption>
          </figure>
        </div>
        <aside class="product-panel" data-reveal>
          <div class="window-bar"><span>{page.productTitle}</span><ProjectIcon name="package" /></div>
          {page.products.map(([title, body]) => <article><ProjectIcon name={title.includes("Active") || title === "原料药" ? "database" : "package"} size={26} /><div><h3>{title}</h3><p>{body}</p></div></article>)}
          <p class="boundary-note">{page.productNote}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section work-section">
    <div class="shell">
      <SectionHeading kicker={page.workKicker} title={page.workTitle} />
      <div class="work-grid">
        {page.work.map(([title, body], index) => <article class="work-card" data-reveal style={`--i:${index}`}>
          <span>0{index + 1}</span><ProjectIcon name={workIcons[index]} size={30} /><h3>{title}</h3><p>{body}</p><i aria-hidden="true"></i>
        </article>)}
      </div>
    </div>
  </section>

  <section id="digital" class="section digital-section">
    <div class="shell digital-intro">
      <SectionHeading kicker={page.digitalKicker} title={page.digitalTitle} light />
      <div data-reveal><p class="digital-lead">{page.digitalLead}</p><p>{page.digitalBody}</p></div>
    </div>
    <div class="shell tool-stack">
      <article class="tool-window quote-window" data-reveal>
        <div class="tool-copy">
          <span>{interfaceCopy.liveTool}</span><ProjectIcon name="file-text" size={34} /><h3>{page.quoteTitle}</h3><p>{page.quoteBody}</p>
          <ButtonLink href={site.quoteTool} variant="paper" icon="arrow-up-right" external>{page.quoteCta}</ButtonLink>
        </div>
        <div class="tool-screen image-zoom-surface">
          <div class="window-bar"><span>quote.jedliuai.com</span><ProjectIcon name="arrow-up-right" /></div>
          <img src="/images/quote-tool-demo.webp" width="2028" height="1107" alt={locale === "zh" ? "Jed 报价与合同工具界面" : "Jed's quote and contract tool interface"} loading="lazy" decoding="async" />
          <button class="image-zoom-trigger" type="button" data-image-zoom data-image-src="/images/quote-tool-demo.webp" data-image-alt={locale === "zh" ? "Jed 报价与合同工具界面" : "Jed's quote and contract tool interface"} data-image-title={page.quoteTitle} aria-label={locale === "zh" ? "全屏查看报价与合同工具截图" : "View the quote and contract tool screenshot full screen"}>
            <ProjectIcon name="magnifying-glass" size={21} /><span>{locale === "zh" ? "放大查看" : "View larger"}</span>
          </button>
        </div>
      </article>

      <article class="tool-window cockpit-window" data-gallery data-reveal>
        <div class="cockpit-copy">
          <span>{interfaceCopy.privateSystem}</span><ProjectIcon name="chart-line-up" size={34} /><h3>{page.cockpitTitle}</h3><p>{page.cockpitBody}</p>
          <div class="gallery-tabs" role="tablist" aria-label={page.cockpitTitle}>
            {page.cockpitTabs.map((label, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} class:list={{ "is-active": index === 0 }} data-gallery-tab><span>0{index + 1}</span>{label}</button>)}
          </div>
        </div>
        <div class="cockpit-stage">
          <div class="window-bar"><span>{interfaceCopy.cockpitWindow}</span><ProjectIcon name="database" /></div>
          {cockpitImages.map((image, index) => <figure data-gallery-panel hidden={index !== 0} class:list={{ "is-active": index === 0 }}>
            <img src={image.src} width={image.width} height={image.height} alt={`${page.cockpitTabs[index]} — ${locale === "zh" ? "虚构公司与合成数据演示" : "fictional companies and synthetic demo data"}`} loading="lazy" decoding="async" />
            <button class="image-zoom-trigger" type="button" data-image-zoom data-image-src={image.src} data-image-alt={`${page.cockpitTabs[index]} — ${locale === "zh" ? "虚构公司与合成数据演示" : "fictional companies and synthetic demo data"}`} data-image-title={page.cockpitTabs[index]} aria-label={locale === "zh" ? `全屏查看${page.cockpitTabs[index]}截图` : `View ${page.cockpitTabs[index]} full screen`}>
              <ProjectIcon name="magnifying-glass" size={21} /><span>{locale === "zh" ? "放大查看" : "View larger"}</span>
            </button>
          </figure>)}
        </div>
      </article>

      <article class="insight-window" data-reveal>
        <div><span>{interfaceCopy.informationWorkflow}</span><ProjectIcon name="network" size={34} /><h3>{page.insightTitle}</h3></div><p>{page.insightBody}</p>
        <div class="signal-line" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </article>
    </div>
  </section>

  <section class="section industry-section">
    <div class="shell industry-grid">
      <div><SectionHeading kicker={page.industryKicker} title={page.industryTitle} body={page.industryBody} /></div>
      <div class="ecosystem" data-ecosystem data-reveal>
        <div class="ecosystem-center"><img src={site.portrait} width="120" height="120" alt="Jed Liu" /><strong>JED LIU</strong><span>{interfaceCopy.ecosystemRole}</span></div>
        <div class="ecosystem-orbit">
          {page.nodes.map((node, index) => <div class="ecosystem-node" style={`--angle:${index * 60 - 90}deg;--counter-angle:${90 - index * 60}deg;--node-index:${index}`}>
            <div class="ecosystem-node-card"><ProjectIcon name={index === 0 ? "factory" : index === 1 ? "package" : index === 2 ? "file-text" : index === 3 ? "seal-check" : index === 4 ? "truck" : "users-three"} /><span>{node}</span></div>
          </div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section approach-section">
    <div class="shell approach-grid">
      <div><p class="kicker">{page.approachKicker}</p><h2>{page.approachTitle}</h2></div>
      <div class="approach-quote" data-reveal><span>“</span><p>{page.approachBody}</p><small>JED LIU / {locale === "zh" ? "工作方法" : "WORKING PRINCIPLE"}</small></div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="shell contact-grid">
      <div class="contact-intro"><p class="kicker">{page.contactKicker}</p><h2>{page.contactTitle}</h2><p>{page.contactBody}</p></div>
      <div class="contact-list">
        {contacts.map((channel, index) => channel.dialog ? (
          <button class={`contact-channel contact-channel--${channel.id}`} type="button" data-open-wechat data-reveal><span><i>0{index + 1}</i><ProjectIcon name={contactIcons[channel.id]} size={25} /></span><strong>{channel.label[locale]}</strong><small>{channel.value}</small><ProjectIcon name="arrow-up-right" /></button>
        ) : (
          <a class={`contact-channel contact-channel--${channel.id}`} href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noopener noreferrer" : undefined} data-reveal>
            <span><i>0{index + 1}</i><ProjectIcon name={contactIcons[channel.id]} size={25} /></span><strong>{channel.label[locale]}</strong><small>{channel.id === "linkedin" ? (locale === "zh" ? "建立职业联系" : channel.value) : channel.value}</small><ProjectIcon name="arrow-up-right" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
