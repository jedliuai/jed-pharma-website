---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import ContactBand from "@/components/ContactBand.astro";
import MetricStrip from "@/components/MetricStrip.astro";
import ProjectConsole from "@/components/ProjectConsole.astro";
import ProjectIcon from "@/components/ProjectIcon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { projectCases, routeMap, type Locale } from "@/config/site";
import { common, home } from "@/data/copy";
interface Props { locale: Locale }
const { locale } = Astro.props;
const page = home[locale]; const c = common[locale]; const path = routeMap.home[locale];
const capabilityIcons = ["globe", "sliders-horizontal", "truck"] as const;
const caseImages = ["/images/case-registration-v2.png", "/images/case-manufacturing-v2.png", "/images/case-delivery-v2.png"];
---
<BaseLayout locale={locale} route="home" path={path}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-enter">{c.eyebrow}</p>
        <h1 class="hero-enter">{page.heroTitle}</h1>
        <p class="hero-lead hero-enter">{page.heroLead}</p>
        <p class="hero-caption hero-enter">{page.heroCaption}</p>
        <div class="hero-actions hero-enter"><ButtonLink href={routeMap.contact[locale]}>{c.primaryCta}</ButtonLink><ButtonLink href="#method" variant="outline">{c.secondaryCta}</ButtonLink></div>
      </div>
      <div class="hero-console"><ProjectConsole locale={locale} /></div>
    </div>
    <a class="scroll-cue" href="#capabilities" aria-label={locale === "zh" ? "向下浏览" : "Scroll to capabilities"}><span>{locale === "zh" ? "向下" : "SCROLL"}</span><ProjectIcon name="arrow-down" /></a>
  </section>
  <MetricStrip locale={locale} />

  <section id="capabilities" class="section capabilities">
    <div class="shell">
      <SectionHeading kicker={locale === "zh" ? "连接系统" : "CONNECTED SYSTEM"} title={page.capabilitiesTitle} body={page.capabilitiesLead} />
      <div class="capability-grid">
        {page.capabilities.map(([title, body], index) => <article class="capability-card" data-reveal style={`--i:${index}`}><span class="card-number">0{index + 1}</span><ProjectIcon name={capabilityIcons[index]} size={30} /><h3>{title}</h3><p>{body}</p><a href={routeMap.expertise[locale]} aria-label={title}><ProjectIcon name="arrow-up-right" /></a></article>)}
      </div>
    </div>
  </section>

  <section id="method" class="section process-section" data-process>
    <div class="shell process-layout">
      <div class="process-intro"><SectionHeading kicker={page.methodKicker} title={page.methodTitle} /><p>{locale === "zh" ? "选择任一阶段，查看这套方法如何保持项目行动、负责人和依赖关系清晰。" : "Select a stage to see how the method keeps actions, owners and dependencies clear."}</p></div>
      <div class="process-console" data-reveal>
        <div class="process-tabs" role="tablist" aria-label={page.methodTitle}>{page.process.map(([title], index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} class:list={{ "is-active": index === 0 }} data-process-tab><span>0{index + 1}</span>{title}</button>)}</div>
        <div class="process-panels">{page.process.map(([title, body], index) => <article data-process-panel hidden={index !== 0} class:list={{ "is-active": index === 0 }}><span>{locale === "zh" ? "阶段" : "PHASE"} 0{index + 1} / 06</span><h3>{title}</h3><p>{body}</p><div class="process-line"><i></i><b>{locale === "zh" ? "持续推进" : "KEEP MOVING"}</b></div></article>)}</div>
      </div>
    </div>
  </section>

  <section class="section markets-home">
    <div class="shell markets-home-grid">
      <div><SectionHeading kicker={page.marketsKicker} title={page.marketsTitle} body={page.marketsLead} /><ButtonLink href={routeMap.markets[locale]} variant="outline" icon="arrow-right">{locale === "zh" ? "查看市场经验" : "Explore markets"}</ButtonLink></div>
      <figure class="map-window" data-reveal><div class="window-bar"><span>MARKET CONTEXT</span><ProjectIcon name="map-trifold" /></div><img src="/images/markets-map-v2.png" width="1600" height="800" alt={locale === "zh" ? "拉丁美洲、独联体与东欧市场地图" : "Map of Latin America, CIS and Eastern Europe"} loading="lazy" /><figcaption><span>LATAM</span><span>CIS / EASTERN EUROPE</span></figcaption></figure>
    </div>
  </section>

  <section class="section cases-home">
    <div class="shell"><SectionHeading kicker={locale === "zh" ? "项目片段" : "PROJECT SNAPSHOTS"} title={page.casesTitle} /></div>
    <div class="case-rail" data-reveal><div class="case-track">{projectCases.map((project, index) => <a class="case-card" href={`${routeMap.projects[locale]}#${project.id}`}><div><span>{project.number} / 03</span><ProjectIcon name="arrow-up-right" /></div><img src={caseImages[index]} width="1774" height="887" alt="" loading="lazy" /><h3>{project.title[locale]}</h3><p>{project.situation[locale]}</p></a>)}</div></div>
  </section>

  <section class="section ai-section">
    <div class="shell ai-grid">
      <SectionHeading kicker="AI / AUTOMATION" title={page.aiTitle} body={page.aiLead} light />
      <ol>{page.aiItems.map((item, index) => <li data-reveal><span>0{index + 1}</span><ProjectIcon name={index === 0 ? "magnifying-glass" : index === 1 ? "list-checks" : "sparkle"} size={26} /><strong>{item}</strong></li>)}</ol>
    </div>
  </section>

  <section class="section faq-section"><div class="shell faq-grid"><SectionHeading kicker="FAQ" title={page.faqTitle} /><div class="faq-list">{page.faq.map(([question, answer], index) => <details data-reveal open={index === 0}><summary><span>0{index + 1}</span>{question}<ProjectIcon name="caret-down" /></summary><p>{answer}</p></details>)}</div></div></section>
  <ContactBand locale={locale} />
</BaseLayout>
