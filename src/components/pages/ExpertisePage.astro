---
import BaseLayout from "@/layouts/BaseLayout.astro"; import PageHero from "@/components/PageHero.astro"; import ContactBand from "@/components/ContactBand.astro"; import SectionHeading from "@/components/SectionHeading.astro"; import ProjectIcon from "@/components/ProjectIcon.astro"; import ProjectConsole from "@/components/ProjectConsole.astro"; import { routeMap, type Locale } from "@/config/site"; import { expertise } from "@/data/copy";
interface Props { locale: Locale } const { locale } = Astro.props; const page = expertise[locale];
---
<BaseLayout locale={locale} route="expertise" path={routeMap.expertise[locale]}><PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="01" />
<section class="section"><div class="shell capability-grid">{page.areas.map(([title, body], index) => <article class="capability-card" data-reveal><span class="card-number">0{index + 1}</span><ProjectIcon name={index === 0 ? "globe" : index === 1 ? "sliders-horizontal" : "truck"} size={30}/><h2>{title}</h2><p>{body}</p></article>)}</div></section>
<section class="section process-section"><div class="shell expertise-chain"><SectionHeading kicker={locale === "zh" ? "端到端路径" : "END-TO-END PATH"} title={page.chainTitle}/><ol>{page.chain.map((item,index)=><li data-reveal><span>0{index+1}</span><strong>{item}</strong><i></i></li>)}</ol></div></section>
<section class="section"><div class="shell split-heading"><SectionHeading kicker={locale === "zh" ? "产品经验" : "PRODUCT CONTEXT"} title={page.productsTitle}/><p>{page.productsLead}</p></div><div class="shell product-layout"><ProjectConsole locale={locale} compact={true} auto={false}/><div class="product-cards">{page.groups.map(([title,body],index)=><article data-reveal><span>CONTEXT / 0{index+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section><ContactBand locale={locale}/></BaseLayout>
