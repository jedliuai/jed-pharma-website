---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ContactBand from "@/components/ContactBand.astro";
import { routeMap, site, type Locale } from "@/config/site";
import { about } from "@/data/copy";

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = about[locale];
const path = routeMap.about[locale];
---

<BaseLayout locale={locale} route="about" path={path}>
  <PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="04" />
  <section class="section section--paper about-story">
    <div class="shell about-story-grid">
      <figure data-reveal>
        <img src={site.portrait} width="1400" height="1400" alt={locale === "zh" ? "Jed Liu 个人头像" : "Portrait of Jed Liu"} />
        <figcaption>JED LIU / {locale === "zh" ? "医药国际业务" : "PHARMA INTERNATIONAL"}</figcaption>
      </figure>
      <div class="story-copy" data-reveal>
        {page.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--ice">
    <div class="shell timeline-grid">
      <header data-reveal>
        <p class="eyebrow">{locale === "zh" ? "职业路径" : "PROGRESSION"}</p>
        <h2>{page.timelineTitle}</h2>
      </header>
      <ol>
        {page.timeline.map(([title, body], index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section principles">
    <div class="shell">
      <p class="eyebrow">{locale === "zh" ? "工作方法" : "WORKING METHOD"}</p>
      <h2>{page.principlesTitle}</h2>
      <div class="principle-grid">
        {page.principles.map(([title, body], index) => (
          <article data-reveal><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
    </div>
  </section>
  <ContactBand locale={locale} />
</BaseLayout>
