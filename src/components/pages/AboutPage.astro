---
import BaseLayout from "@/layouts/BaseLayout.astro"; import PageHero from "@/components/PageHero.astro"; import ContactBand from "@/components/ContactBand.astro"; import SectionHeading from "@/components/SectionHeading.astro"; import ProjectIcon from "@/components/ProjectIcon.astro"; import {routeMap,site,type Locale} from "@/config/site"; import {about} from "@/data/copy";
interface Props{locale:Locale} const{locale}=Astro.props;const page=about[locale];
---
<BaseLayout locale={locale} route="about" path={routeMap.about[locale]}><PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="04"/><section class="section"><div class="shell profile-layout"><figure class="profile-frame" data-reveal><div class="window-bar"><span>JED LIU / PROFILE</span><ProjectIcon name="dots-three"/></div><img src={site.portrait} width="1400" height="1400" alt={locale === "zh" ? "Jed Liu 肖像" : "Portrait of Jed Liu"}/><figcaption>{locale === "zh" ? "医药国际业务" : "PHARMACEUTICAL INTERNATIONAL BUSINESS"}</figcaption></figure><div class="profile-story" data-reveal><p class="kicker">{locale === "zh" ? "职业定位" : "POSITIONING"}</p>{page.story.map(p=><p>{p}</p>)}</div></div></section>
<section class="section process-section"><div class="shell timeline-layout"><SectionHeading kicker={locale === "zh" ? "职业路径" : "PROGRESSION"} title={page.timelineTitle}/><ol>{page.timeline.map(([title,body],index)=><li data-reveal><span>0{index+1}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol></div></section>
<section class="section"><div class="shell"><SectionHeading kicker={locale === "zh" ? "工作方法" : "WORKING METHOD"} title={page.principlesTitle}/><div class="principles-grid">{page.principles.map(([title,body],index)=><article data-reveal><span>0{index+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div><div class="ai-callout" data-reveal><ProjectIcon name="sparkle" size={28}/><div><h2>{page.aiTitle}</h2><p>{page.aiBody}</p></div></div></div></section><ContactBand locale={locale}/></BaseLayout>
