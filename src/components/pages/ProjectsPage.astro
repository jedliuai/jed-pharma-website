---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ContactBand from "@/components/ContactBand.astro";
import { projectCases, routeMap, type Locale } from "@/config/site";
import { projects } from "@/data/copy";

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = projects[locale];
const path = routeMap.projects[locale];
const caseImages = ["/images/case-registration-v2.png", "/images/case-manufacturing-v2.png", "/images/case-delivery-v2.png"];
---

<BaseLayout locale={locale} route="projects" path={path}>
  <div class="detail-v2 detail-v2--projects">
    <PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="03" />
    <section class="detail-v2-section detail-v2-cases" aria-labelledby="case-list-title">
      <div class="shell">
        <h2 id="case-list-title" class="sr-only">{locale === "zh" ? "三个匿名项目案例" : "Three anonymized project cases"}</h2>
        <p class="detail-v2-basis" data-reveal>{page.basis}</p>
        <div class="detail-v2-case-list">
          {projectCases.map((project, index) => (
            <article class="detail-v2-case" id={project.id} data-reveal>
              <header>
                <div><span>CASE / {project.number}</span><h3>{project.title[locale]}</h3></div>
                <img src={caseImages[index]} width="1774" height="887" alt={`${project.title[locale]} — ${locale === "zh" ? "匿名案例配图" : "anonymized case illustration"}`} loading="lazy" />
              </header>
              <div class="detail-v2-case-grid">
                <section><h4>{page.situation}</h4><p>{project.situation[locale]}</p></section>
                <section><h4>{page.role}</h4><ul>{project.role[locale].map((item) => <li>{item}</li>)}</ul></section>
                <section><h4>{page.demonstrates}</h4><ul class="detail-v2-tags">{project.demonstrates[locale].map((item) => <li>{item}</li>)}</ul></section>
              </div>
            </article>
          ))}
        </div>
        <aside class="detail-v2-boundary" data-reveal><span>PRIVACY / 01</span><p>{page.privacy}</p></aside>
      </div>
    </section>
    <ContactBand locale={locale} />
  </div>
</BaseLayout>
