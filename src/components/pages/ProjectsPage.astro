---
import BaseLayout from "@/layouts/BaseLayout.astro"; import PageHero from "@/components/PageHero.astro"; import ContactBand from "@/components/ContactBand.astro"; import ProjectIcon from "@/components/ProjectIcon.astro"; import { projectCases, routeMap, type Locale } from "@/config/site"; import { projects } from "@/data/copy";
interface Props { locale: Locale } const {locale}=Astro.props; const page=projects[locale]; const imgs=["/images/case-registration-v2.png","/images/case-manufacturing-v2.png","/images/case-delivery-v2.png"];
---
<BaseLayout locale={locale} route="projects" path={routeMap.projects[locale]}><PageHero kicker={page.kicker} title={page.title} lead={page.lead} index="03"/><section class="section"><div class="shell"><p class="basis-note" data-reveal>{page.basis}</p><div class="project-list">{projectCases.map((project,index)=><article class="project-case" id={project.id} data-reveal><header><div><span>CASE / {project.number}</span><h2>{project.title[locale]}</h2></div><img src={imgs[index]} width="1774" height="887" alt="" loading="lazy"/></header><div class="project-columns"><section><h3>{page.situation}</h3><p>{project.situation[locale]}</p></section><section><h3>{page.role}</h3><ul>{project.role[locale].map(item=><li><ProjectIcon name="check" size={15}/>{item}</li>)}</ul></section><section><h3>{page.demonstrates}</h3><div class="tag-list">{project.demonstrates[locale].map(item=><span>{item}</span>)}</div></section></div></article>)}</div><aside class="privacy-note"><span>PRIVACY / 01</span><p>{page.privacy}</p></aside></div></section><ContactBand locale={locale}/></BaseLayout>
