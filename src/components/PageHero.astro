---
interface Props { kicker: string; title: string; lead: string; index: string }
const { kicker, title, lead, index } = Astro.props;
---
<section class="page-hero">
  <div class="shell page-hero-grid">
    <div data-reveal>
      <p class="kicker"><span>{index}</span>{kicker}</p>
      <h1>{title}</h1>
    </div>
    <div class="page-hero-aside" data-reveal>
      <span>JED / {index}</span>
      <p>{lead}</p>
    </div>
  </div>
</section>
