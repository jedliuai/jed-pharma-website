---
interface Props {
  kicker: string;
  title: string;
  body?: string;
  light?: boolean;
}

const { kicker, title, body, light = false } = Astro.props;
---

<header class:list={["section-heading", { "section-heading--light": light }]} data-reveal>
  <div class="section-heading__meta"><span aria-hidden="true"></span><p class="eyebrow">{kicker}</p></div>
  <h2 class="section-heading__title">{title}</h2>
  {body && <p class="section-lead">{body}</p>}
</header>
