---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ShippingProgress from "@/components/ShippingProgress.astro";
import WeChatDialog from "@/components/WeChatDialog.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import SiteMotion from "@/components/SiteMotion.astro";
import { alternatePath, designTokens, site, type Locale } from "@/config/site";
import { common, home, seo } from "@/data/copy";
import { contentUpdatedAt, profileModifiedAt } from "@/config/content-meta.mjs";

interface Props {
  locale: Locale;
  path: string;
  title?: string;
  description?: string;
  pageKind?: "profile" | "article" | "collection";
  extraGraph?: Record<string, unknown>[];
}

const { locale, path, title, description, pageKind = "profile", extraGraph = [] } = Astro.props;
const meta = { title: title ?? seo[locale].title, description: description ?? seo[locale].description };
const englishPath = alternatePath(path, "en");
const chinesePath = alternatePath(path, "zh");
const canonical = new URL(path, site.origin).toString();
const ogImage = new URL(site.portrait, site.origin).toString();
const ogImageAlt = locale === "zh" ? "Jed Liu 个人肖像" : "Portrait of Jed Liu";
const c = common[locale];
const page = home[locale];
const language = locale === "zh" ? "zh-CN" : "en-US";
const personId = site.canonicalPersonId;
const translatedPage = new URL(locale === "zh" ? englishPath : chinesePath, site.origin).toString();
const knowsAbout = locale === "zh"
  ? ["医药国际业务", "拉丁美洲与中亚/CIS 医药市场", "医药注册协调", "医药国际项目执行", "AI 增强的外贸工作流"]
  : ["Pharmaceutical international business", "Latin America and Central Asia/CIS pharmaceutical markets", "Pharmaceutical registration coordination", "International pharmaceutical project execution", "AI-enabled trade workflows"];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Jed Liu",
      url: site.origin,
      image: ogImage,
      description: seo[locale].description,
      jobTitle: locale === "zh" ? "医药国际业务从业者" : "Pharmaceutical International Business Professional",
      email: `mailto:${site.email}`,
      telephone: site.phone,
      sameAs: [site.personalSite, site.linkedin, site.github, site.contactCard],
      knowsLanguage: ["Chinese", "English"],
      workLocation: { "@type": "Country", name: "China" },
      knowsAbout
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: site.origin,
      name: locale === "zh" ? site.nameZh : site.name,
      inLanguage: ["en-US", "zh-CN"],
      publisher: { "@id": personId }
    },
    {
      "@type": pageKind === "profile" ? "ProfilePage" : pageKind === "collection" ? "CollectionPage" : "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: meta.title,
      description: meta.description,
      inLanguage: language,
      dateModified: pageKind === "profile" ? profileModifiedAt : contentUpdatedAt,
      isPartOf: { "@id": `${site.origin}/#website` },
      ...(pageKind === "profile" ? { mainEntity: { "@id": personId }, hasPart: { "@id": `${canonical}#faq` } } : {}),
      ...(locale === "zh"
        ? { translationOfWork: { "@id": `${translatedPage}#webpage` } }
        : { workTranslation: { "@id": `${translatedPage}#webpage` } }),
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage,
        caption: ogImageAlt
      }
    },
    ...(pageKind === "profile" ? [{
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      url: `${canonical}#faq`,
      inLanguage: language,
      isPartOf: { "@id": `${site.origin}/#website` },
      mainEntity: page.faq.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: {
          "@type": "Answer",
          text: answer
        }
      }))
    }] : []),
    ...extraGraph
  ]
};
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={designTokens.warmIvory} />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={meta.description} />
    <meta name="author" content="Jed Liu" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <title>{meta.title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, site.origin)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(chinesePath, site.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(englishPath, site.origin)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content={pageKind === "profile" ? "profile" : pageKind === "article" ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="profile:first_name" content="Jed" />
    <meta property="profile:last_name" content="Liu" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "zh" ? "跳到主要内容" : "Skip to main content"}</a>
    <SiteHeader locale={locale} path={path} />
    {pageKind === "profile" && <ShippingProgress locale={locale} />}
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <WeChatDialog locale={locale} title={c.wechatTitle} body={c.wechatBody} closeLabel={c.close} />
    <ImageLightbox locale={locale} />
    <SiteMotion />
  </body>
</html>
